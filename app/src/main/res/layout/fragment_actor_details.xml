<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="model"
            type="com.morgan.movies.data.models.ActorDetailsResponse" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/main_nested_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black_op"
        android:paddingTop="@dimen/_12sdp"
        android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        tools:context=".ui.actorDetails.ActorDetailsFragment">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="@dimen/_12sdp" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_end="@dimen/_12sdp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/actor_cardview"
            android:layout_height="@dimen/_130sdp"
            android:layout_width="@dimen/_85sdp"
            app:cardCornerRadius="20dp"
            android:layout_centerHorizontal="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="@+id/guideline_start">

            <ImageView
                android:id="@+id/actor_image"
                android:layout_height="@dimen/_130sdp"
                android:layout_width="@dimen/_85sdp"
                android:contentDescription="@string/todo"
                android:scaleType="fitXY"
                tools:src="@drawable/actor_image"/>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/actor_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginStart="@dimen/_16sdp"
            android:gravity="start"
            android:text="@{model.name}"
            android:textColor="@color/Gray"
            android:fontFamily="@font/comic_sans_bold"
            android:textSize="@dimen/_18ssp"
            android:textStyle="normal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintStart_toEndOf="@+id/actor_cardview"
            tools:text="Dwayne Johnson"/>

        <TextView
            android:id="@+id/txt_birthday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginStart="@dimen/_16sdp"
            android:text="@string/birthday"
            android:textColor="@color/Pink"
            android:fontFamily="@font/comic_sans_bold"
            android:textSize="@dimen/_12ssp"
            android:textStyle="normal"
            app:layout_constraintTop_toBottomOf="@+id/actor_name"
            app:layout_constraintStart_toEndOf="@+id/actor_cardview" />

        <TextView
            android:id="@+id/actor_birthday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_5sdp"
            android:gravity="center"
            android:textColor="@color/Gray"
            android:fontFamily="@font/comic_sans"
            android:textSize="@dimen/_12ssp"
            android:textStyle="normal"
            app:layout_constraintStart_toEndOf="@+id/txt_birthday"
            app:layout_constraintTop_toTopOf="@+id/txt_birthday"
            app:layout_constraintBottom_toBottomOf="@+id/txt_birthday"
            tools:text="1972-05-02"/>

        <TextView
            android:id="@+id/txt_died_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:gravity="center"
            android:text="@string/died"
            android:textColor="@color/Pink"
            android:fontFamily="@font/comic_sans_bold"
            android:textSize="@dimen/_12ssp"
            android:textStyle="normal"
            app:layout_constraintTop_toBottomOf="@+id/txt_birthday"
            app:layout_constraintStart_toStartOf="@+id/txt_birthday"/>

        <TextView
            android:id="@+id/actor_died_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_5sdp"
            android:gravity="center"
            android:textColor="@color/Gray"
            android:fontFamily="@font/comic_sans"
            android:textSize="@dimen/_12ssp"
            android:textStyle="normal"
            app:layout_constraintStart_toEndOf="@+id/txt_died_day"
            app:layout_constraintTop_toTopOf="@+id/txt_died_day"
            app:layout_constraintBottom_toBottomOf="@+id/txt_died_day"
            tools:text="1972-05-02"/>

        <TextView
            android:id="@+id/txt_born"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:text="@string/born"
            android:textColor="@color/Pink"
            android:fontFamily="@font/comic_sans_bold"
            android:textSize="@dimen/_12ssp"
            android:textStyle="normal"
            app:layout_constraintTop_toBottomOf="@+id/txt_died_day"
            app:layout_constraintStart_toStartOf="@+id/txt_died_day"/>

        <TextView
            android:id="@+id/actor_born"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_5sdp"
            android:gravity="start"
            android:textColor="@color/Gray"
            android:fontFamily="@font/comic_sans"
            android:textSize="@dimen/_12ssp"
            android:textStyle="normal"
            app:layout_constraintStart_toEndOf="@+id/txt_born"
            app:layout_constraintEnd_toEndOf="@+id/guideline_end"
            app:layout_constraintTop_toTopOf="@+id/txt_born"
            tools:text="Hayward, California, USA"/>

        <TextView
            android:id="@+id/txt_biography"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:text="@string/biography"
            android:textColor="@color/Pink"
            android:fontFamily="@font/comic_sans_bold"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintTop_toBottomOf="@+id/actor_cardview"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btn_lang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/_4sdp"
            android:paddingBottom="@dimen/_4sdp"
            android:paddingStart="@dimen/_6sdp"
            android:paddingEnd="@dimen/_6sdp"
            android:layout_marginEnd="@dimen/_16sdp"
            android:background="@drawable/rounded_black_op_corner_50_red_stroke"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintTop_toTopOf="@+id/txt_biography"
            app:layout_constraintBottom_toBottomOf="@+id/txt_biography">

            <ImageView
                android:id="@+id/ic_lang"
                android:layout_width="@dimen/_12sdp"
                android:layout_height="@dimen/_12sdp"
                android:src="@drawable/ic_language"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:contentDescription="@string/todo" />
            <TextView
                android:id="@+id/txt_language"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/comic_sans"
                android:layout_marginStart="@dimen/_4sdp"
                android:text="@string/arabic"
                android:textColor="@color/Gray"
                android:textSize="@dimen/_8ssp"
                app:layout_constraintStart_toEndOf="@+id/ic_lang"
                app:layout_constraintTop_toTopOf="@id/ic_lang"
                app:layout_constraintBottom_toBottomOf="@id/ic_lang"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/biography_nested_scroll_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:layout_marginTop="@dimen/_8sdp"
            app:layout_constraintHeight_max="@dimen/_200sdp"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintTop_toBottomOf="@+id/txt_biography">

            <TextView
                android:id="@+id/biography_description"
                style="@style/Theme.MovieTextStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_12ssp"
                tools:text="@string/biography_description" />

        </androidx.core.widget.NestedScrollView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/_5sdp"
            android:paddingBottom="@dimen/_5sdp"
            android:paddingStart="@dimen/_10sdp"
            android:paddingEnd="@dimen/_10sdp"
            android:background="@drawable/rounded_black_op_corner_50_red_stroke"
            app:layout_constraintEnd_toEndOf="@+id/guideline_end"
            app:layout_constraintTop_toTopOf="@+id/txt_movies"
            app:layout_constraintBottom_toBottomOf="@+id/txt_movies">

            <ImageView
                android:id="@+id/sort_icon"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:contentDescription="@string/todo"
                android:src="@drawable/sort_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/btn_sort_by_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_10sdp"
                android:fontFamily="@font/comic_sans_bold"
                android:textColor="@color/Gray"
                android:textSize="@dimen/_12ssp"
                android:text="@string/date"
                app:layout_constraintEnd_toStartOf="@id/sort_icon"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/btn_sort_by_rate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_10sdp"
                android:fontFamily="@font/comic_sans_bold"
                android:textColor="@color/Gray"
                android:textSize="@dimen/_12ssp"
                android:text="@string/rate"
                app:layout_constraintEnd_toStartOf="@id/btn_sort_by_date"
                app:layout_constraintTop_toTopOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/txt_movies"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp"
            android:text="@string/movies"
            android:textColor="@color/Pink"
            android:fontFamily="@font/comic_sans_bold"
            android:textSize="@dimen/_12ssp"
            android:textStyle="normal"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintTop_toBottomOf="@+id/biography_nested_scroll_view"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/actor_movies_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp"
            android:layout_marginStart="@dimen/_5sdp"
            android:padding="@dimen/_4sdp"
            android:orientation="vertical"
            app:spanCount="2"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:layout_constraintTop_toBottomOf="@id/txt_movies"
            tools:listitem="@layout/item_movie_search" />

        <LinearLayout
            android:id="@+id/actor_no_movies"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txt_movies"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:layout_width="@dimen/_85sdp"
                android:layout_height="@dimen/_85sdp"
                android:src="@drawable/no_movies_image_pink"
                android:contentDescription="@string/todo" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:textColor="@color/Gray"
                android:textStyle="bold"
                android:textSize="@dimen/_16ssp"
                android:text="@string/there_are_no_movies_to_show"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/main_progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:indeterminateTint="@color/Pink"
            android:indeterminateTintMode="src_atop"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</layout>